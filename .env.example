# ── Hedera EVM (Chain ID 296) ─────────────────────────────────────────
HEDERA_TESTNET_RPC=https://testnet.hashio.io/api
PRIVATE_KEY=
HEDERA_OPERATOR_ID=0.0.xxxxxxx
HEDERA_OPERATOR_KEY=
HEDERA_HCS_TOPIC_ID=0.0.xxxxxxx
HEDERA_NETWORK=testnet
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
NEXT_PUBLIC_AETHERIS_AGENCY_ADDRESS=
NEXT_PUBLIC_AETHERIS_TREASURY_ADDRESS=
# EVM long-zero address of an HTS token (0.0.x -> 0x...). If set, deploy.js
# auto-associates the treasury. The treasury AND each sub-agent must be
# associated before any HTS token can be escrowed or paid out.
AETHERIS_HTS_TOKEN_ADDRESS=
AETHERIS_ENS_NAME=aetheris.eth

# ── World ID ──────────────────────────────────────────────────────────
NEXT_PUBLIC_WORLD_ID_APP_ID=app_staging_xxxxxxxxxxxxxxxx
NEXT_PUBLIC_WORLD_ID_ACTION=aetheris-operator
WORLD_ID_API_BASE=https://developer.worldcoin.org
# Leave WORLD_ID_ROUTER_ADDRESS unset to deploy in EXPLICIT bypass mode:
# the ZK personhood check is skipped (nullifier replay protection stays ON)
# and the contract emits WorldIdBypassActive + OperatorVerifiedWithoutProof.
# Set it to enable real on-chain proof verification.
WORLD_ID_ROUTER_ADDRESS=
WORLD_ID_GROUP_ID=1

# ── Privy ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ── 1inch Swap API v6.0 ───────────────────────────────────────────────
ONEINCH_API_KEY=
NEXT_PUBLIC_ONEINCH_BASE_URL=https://api.1inch.dev

# ── The Graph ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUBGRAPH_URL=
GRAPH_DEPLOY_KEY=

# ── ENS (mainnet resolution) ──────────────────────────────────────────
# lib/ens.ts falls back to publicnode/drpc/ankr/cloudflare if this is unset or failing.
NEXT_PUBLIC_ENS_RPC_URL=https://ethereum-rpc.publicnode.com
