# ── Hedera EVM (Chain ID 296) ─────────────────────────────────────────
HEDERA_TESTNET_RPC=https://testnet.hashio.io/api
PRIVATE_KEY=
HEDERA_OPERATOR_ID=0.0.xxxxxxx
HEDERA_OPERATOR_KEY=
HEDERA_HCS_TOPIC_ID=0.0.xxxxxxx
HEDERA_NETWORK=testnet
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
NEXT_PUBLIC_AETHERIS_AGENCY_ADDRESS=
NEXT_PUBLIC_AETHERIS_TREASURY_ADDRESS=
# Fallback operator shown only when the subgraph has not indexed the agency's Operator
# entity. The live path never shows the demo operator fixture; unset -> 0x000...000 + caveat.
NEXT_PUBLIC_AETHERIS_OPERATOR_ADDRESS=
# EVM long-zero address of an HTS token (0.0.x -> 0x...). If set, deploy.js
# auto-associates the treasury. The treasury AND each sub-agent must be
# associated before any HTS token can be escrowed or paid out.
AETHERIS_HTS_TOKEN_ADDRESS=
AETHERIS_ENS_NAME=aetheris.eth

# ── World ID ──────────────────────────────────────────────────────────
# All three World ID values come from https://developer.worldcoin.org (sign in → your app).
#
# NEXT_PUBLIC_WORLD_ID_APP_ID  - the app id shown at the top of the app page (`app_…`;
#                                staging apps are `app_staging_…` and accept Simulator
#                                proofs). Public: it is shipped to the browser for IDKit.
# NEXT_PUBLIC_WORLD_ID_ACTION  - the action identifier you created under the app's
#                                "Actions" tab. Must match exactly (case-sensitive).
# WORLD_ID_RP_ID / WORLD_ID_RP_SIGNING_KEY - IDKit v4 "RP context". Under the app's
#                                "Relying party" settings, create a relying party: copy its
#                                id (`rp_…`) and the hex signing key. The signing key is a
#                                SERVER-ONLY secret: app/api/worldid/rp-context signs a nonce
#                                with it before the widget opens. Never prefix it NEXT_PUBLIC_.
#
# With APP_ID unset, /api/operator/verify answers 503 WORLD_ID_NOT_CONFIGURED and the UI
# falls back to a clearly-labelled simulated check - it never fakes a verified human.
# Once the cloud proof verifies, /api/operator/verify relays AetherisAgency.verifyOperator
# with PRIVATE_KEY (burning the real nullifier on Hedera; 5 relays/min/IP).
NEXT_PUBLIC_WORLD_ID_APP_ID=app_staging_xxxxxxxxxxxxxxxx
NEXT_PUBLIC_WORLD_ID_ACTION=aetheris-operator
WORLD_ID_RP_ID=rp_xxxxxxxxxxxxxxxx
WORLD_ID_RP_SIGNING_KEY=
WORLD_ID_API_BASE=https://developer.worldcoin.org
# Leave WORLD_ID_ROUTER_ADDRESS unset to deploy in EXPLICIT bypass mode:
# the ZK personhood check is skipped (nullifier replay protection stays ON)
# and the contract emits WorldIdBypassActive + OperatorVerifiedWithoutProof.
# Set it to enable real on-chain proof verification.
WORLD_ID_ROUTER_ADDRESS=
WORLD_ID_GROUP_ID=1

# ── Privy ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ── 1inch Swap API v6.0 ───────────────────────────────────────────────
ONEINCH_API_KEY=
NEXT_PUBLIC_ONEINCH_BASE_URL=https://api.1inch.dev

# ── The Graph ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUBGRAPH_URL=
GRAPH_DEPLOY_KEY=

# ── ENS (mainnet resolution) ──────────────────────────────────────────
# lib/ens.ts falls back to publicnode/drpc/ankr/cloudflare if this is unset or failing.
NEXT_PUBLIC_ENS_RPC_URL=https://ethereum-rpc.publicnode.com

# ── Sub-agent worker (scripts/agent-worker.js, scripts/agent-demo.js) ──
# 0G Compute Router, OpenAI-compatible. Keys start with sk-; every request is billed on-chain.
# The worker refuses to start with an empty key and never fabricates a model response.
ZG_API_KEY=
ZG_BASE_URL=https://router-api.0g.ai/v1
ZG_MODEL=glm-5.2
# Where the worker looks for tasks assigned to it (status Assigned). Defaults to the public VPS mirror.
SUBGRAPH_URL=http://38.49.213.208:8100/subgraphs/name/aetheris
POLL_MS=10000
# Worker identity. Leave empty: the first run of agent:worker / agent:demo creates a Hedera
# testnet account (ECDSA key with EVM alias, 2 HBAR, unlimited auto token associations) with
# the operator client and appends these three lines to .env. Never commit AGENT_WORKER_KEY.
AGENT_WORKER_KEY=
AGENT_WORKER_ID=
AGENT_WORKER_ADDRESS=
